# Cloudflare R2 credentials for the nextcloud-data bucket.
#
# Used by BOTH the Nextcloud chart (primary object storage —
# nextcloud.objectStore.s3.existingSecret) and the nightly backup CronJob.
#
# Mint in the Cloudflare dashboard: R2 → API → Manage API Tokens →
# Create Account API token → permission "Object Read & Write", scoped to the
# `nextcloud-data` bucket. The Secret Access Key is shown once.
#
# In CI this Secret is rendered by .github/workflows/deploy.yml from the GH
# Actions secrets R2_ACCESS_KEY and R2_SECRET_KEY — this template is for
# applying it by hand on a fresh cluster.
#
# Copy to secrets/nextcloud-r2.yaml (gitignored), replace REPLACE_ME, apply.
apiVersion: v1
kind: Secret
metadata:
  name: nextcloud-r2
  namespace: nextcloud
type: Opaque
stringData:
  access-key-id: "REPLACE_ME_R2_ACCESS_KEY_ID"
  secret-access-key: "REPLACE_ME_R2_SECRET_ACCESS_KEY"
